Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Planned Path1
        - /Reference Path1
        - /Actual Path1
      Splitter Ratio: 0.55
    Tree Height: 500
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 160; 160; 164
    - Class: rviz_default_plugins/Path
      Name: Planned Path
      Enabled: true
      Topic:
        Value: __NS__/trajectory_test/planned_path
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 25; 255; 25
      Line Style: Billboards
      Line Width: 0.03
      Buffer Length: 1
    - Class: rviz_default_plugins/Path
      Name: Reference Path
      Enabled: true
      Topic:
        Value: __NS__/trajectory_test/reference_path
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 255; 0
      Line Style: Billboards
      Line Width: 0.05
      Buffer Length: 1
    - Class: rviz_default_plugins/Path
      Name: Actual Path
      Enabled: true
      Topic:
        Value: __NS__/trajectory_test/actual_path
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 40; 40
      Line Style: Billboards
      Line Width: 0.05
      Buffer Length: 1
    - Class: rviz_default_plugins/Pose
      Name: Current Setpoint
      Enabled: true
      Topic:
        Value: __NS__/trajectory_test/setpoint_pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 80; 160; 255
      Shaft Length: 0.6
      Shaft Radius: 0.04
      Head Length: 0.2
      Head Radius: 0.08
    - Class: rviz_default_plugins/Odometry
      Name: Vehicle Odometry
      Enabled: false
      Topic:
        Value: __NS__/mavros/local_position/odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Keep: 1
      Shape:
        Value: Arrow
        Color: 255; 25; 0
  Global Options:
    Background Color: 42; 42; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Pitch: 0.9
      Yaw: 0.78
      Focal Point:
        X: 0
        Y: 0
        Z: 3
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
